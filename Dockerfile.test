FROM rust:1.97.1-trixie

RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y \
    pkg-config \
    libssl-dev \
    libtesseract-dev \
    libleptonica-dev \
    libclang-dev \
    curl \
    nodejs \
    npm \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-fra \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock build.rs rust-toolchain.toml download-models.sh ./
RUN mkdir -p models && bash download-models.sh

COPY src ./src
COPY tests ./tests

RUN cd tests/fixtures/static_server && npm install 2>/dev/null || true

RUN cargo build --release 2>&1

CMD ["cargo", "test", "--release", "--all-features"]
